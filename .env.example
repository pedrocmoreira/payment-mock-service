# Copie para .env e preencha. NUNCA versione o arquivo .env
# Token aceito pela API simulada (use o MESMO valor em MP_ACCESS_TOKEN no billing-service)
MOCK_ACCESS_TOKEN=TEST-troque-este-token
# Segredo usado para assinar os webhooks (MESMO valor de MP_WEBHOOK_SECRET no billing-service)
MOCK_WEBHOOK_SECRET=troque-este-segredo
# URL do simulador vista pelo navegador (página de checkout)
MOCK_PUBLIC_BASE_URL=http://localhost:8084
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
